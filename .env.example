# ------------------------------------------------------------
# App
# ------------------------------------------------------------
DEBUG=false
APP_NAME=SHS GPU Worker Node
WORKER_VERSION=0.1.0
WORKER_PROTOCOL_VERSION=1.0

# ------------------------------------------------------------
# Node
# ------------------------------------------------------------
NODE_ID=shs-gpu-node-01
NODE_NAME=SHS GPU Node 01
HOST=0.0.0.0
PORT=8009
NODE_PUBLIC_BASE_URL=http://192.168.0.99:8009

# ------------------------------------------------------------
# Central Server
# ------------------------------------------------------------
CENTRAL_ENABLED=true
CENTRAL_SERVER_URL=http://cluster.shs
CENTRAL_API_KEY=change-me

CENTRAL_BASE_URL=http://cluster.shs
CENTRAL_REGISTER_PATH=/api/nodes/register
CENTRAL_HEARTBEAT_PATH=/api/nodes/{node_id}/heartbeat
CENTRAL_HEARTBEAT_INTERVAL_SECONDS=10
CENTRAL_REGISTER_RETRY_SECONDS=10

# ------------------------------------------------------------
# Internal API Auth
# ------------------------------------------------------------
SHS_INTERNAL_API_KEY=change-this-secret
SHS_INTERNAL_API_KEY_HEADER=x-shs-internal-api-key

# ------------------------------------------------------------
# Models
# ------------------------------------------------------------
MODEL_DIR=./data/models

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
DEFAULT_LLM_MODEL=llama3.2:latest